{
  "name": "sabinthapa100-academic-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "al-folio/Jekyll academic site with a Quartz Notes garden; legacy Hugo tooling is retained for migration history",
  "scripts": {
    "build": "bash scripts/build_all.sh",
    "build:legacy-hugo": "hugo --minify",
    "dev:legacy-hugo": "hugo server --disableFastRender",
    "pagefind:legacy-hugo": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
